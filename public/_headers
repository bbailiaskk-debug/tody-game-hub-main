/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self' http://localhost:* http://127.0.0.1:* https://*.lovable.app
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self), geolocation=()
  X-XSS-Protection: 0
  Vary: Accept-Encoding

# Content-hashed by Vite: a changed file gets a new name, so these are safe to
# cache hard.
/assets/*
  Cache-Control: public, max-age=2592000, immutable
  CDN-Cache-Control: public, max-age=2592000
  Cloudflare-CDN-Cache-Control: public, max-age=2592000

# Public URLs are stable across builds, so revalidate them instead of marking them immutable.
/fonts/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Access-Control-Allow-Origin: *

/downloads/*
  # The installer is a hundred megabytes and is replaced by hand when there is a
  # new build, so it must never be cached: a stale copy here is somebody running
  # last month's program and blaming it for this month's bug. Short enough that a
  # fresh one arrives on the next visit, long enough that one person's download is
  # not asked for twice by the edge.
  Cache-Control: public, max-age=3600, must-revalidate
  # Sent as a file rather than displayed. Without this the browser opens the .exe
  # in place and the chat disappears behind Windows asking whether to run it.
  Content-Disposition: attachment
  # Nothing here is meant to be embedded or sniffed into something else.
  X-Content-Type-Options: nosniff

/images/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/animo-focus-shift.mp4
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/animo-focus-shift.webm
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/animo-focus-shift-poster.jpg
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/favicon.ico
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/robots.txt
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/site.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/offline.html
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: no-store, must-revalidate
  CDN-Cache-Control: no-store

/sw.js
  Content-Type: application/javascript
  Cache-Control: no-store, no-cache, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
  CDN-Cache-Control: max-age=3600

# Music, voice clips and stickers: tens of megabytes across these three folders.
# The site rarely changes them and re-pulling a 10MB track on every visit is a
# worse trade than the freshness the global rule above buys elsewhere, so they
# revalidate instead of being stored. Matched by prefix; the folders are the
# only ones with Cyrillic names.
/звук на чята/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/мойта музика/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/стикер/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# Root-level files (icon.png, profile-photo.jpg, undraw_*.png, the .ttf/.otf
# fonts) match no rule above, so a replaced one keeps being served from the edge.
#
# These are listed per extension on purpose rather than as a blanket /* rule.
# Matching rules MERGE rather than override: a /* rule carrying no-store makes
# /assets/*.js answer "no-cache, no-store, must-revalidate, public,
# max-age=2592000, immutable", and the first directive is the one honoured, so
# the hashed bundles lose their caching and are revalidated on every load. The
# extensions below are exactly those that never appear in /assets/ (which holds
# only .js and .css), so hashed bundles cannot be caught here.
#
# Placed last so that the more specific rules above keep the leading position
# when two of these merge, which is what keeps the media folders on
# "revalidate" instead of "no-store".
# Cloudflare _headers rules:

