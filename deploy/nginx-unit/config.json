{
  "listeners": {
    "*:80": {
      "pass": "routes/site"
    }
  },
  "routes": {
    "site": [
      {
        "match": {
          "uri": ["*.css", "*.js", "*.mjs"]
        },
        "action": {
          "proxy": "https://tody-game-hub.bbailiaskk.workers.dev",
          "response_headers": {
            "Cache-Control": "public, max-age=1576800000, immutable"
          }
        }
      },
      {
        "match": {
          "uri": ["*.ico", "*.png", "*.jpg", "*.jpeg", "*.webp", "*.avif", "*.gif", "*.svg"]
        },
        "action": {
          "proxy": "https://tody-game-hub.bbailiaskk.workers.dev",
          "response_headers": {
            "Cache-Control": "public, max-age=604800"
          }
        }
      },
      {
        "match": {
          "uri": ["*.woff", "*.woff2", "*.ttf", "*.otf"]
        },
        "action": {
          "proxy": "https://tody-game-hub.bbailiaskk.workers.dev",
          "response_headers": {
            "Cache-Control": "public, max-age=31536000, immutable"
          }
        }
      },
      {
        "match": {
          "uri": ["*.map"]
        },
        "action": {
          "proxy": "https://tody-game-hub.bbailiaskk.workers.dev",
          "response_headers": {
            "Cache-Control": "public, max-age=0, must-revalidate"
          }
        }
      },
      {
        "action": {
          "proxy": "https://tody-game-hub.bbailiaskk.workers.dev",
          "response_headers": {
            "X-Content-Type-Options": "nosniff",
            "X-Frame-Options": "DENY",
            "Referrer-Policy": "strict-origin-when-cross-origin"
          }
        }
      }
    ]
  }
}
