{
  "name": "tody-game-hub",
  "compatibility_date": "2026-08-30",
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "cache_control": [
      {
        "glob": "assets/**",
        "directives": "public, max-age=31536000, immutable"
      },
      {
        "glob": "**/*.{ttf,otf,woff,woff2}",
        "directives": "public, max-age=31536000, immutable"
      },
      {
        "glob": "**/*.{png,jpg,jpeg,webp,avif,gif,ico,svg}",
        "directives": "public, max-age=604800"
      },
      {
        "glob": "**/*.map",
        "directives": "public, max-age=0, must-revalidate"
      }
    ]
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "replace-with-google-client-id"
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_USERS_KV",
      "id": "987d097bccb842538cf6af6ebafdbee5"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHESS_GAME_DO",
        "class_name": "ChessMatchDO"
      },
      {
        "name": "TTT_GAME_DO",
        "class_name": "TicTacToeMatchDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChessMatchDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TicTacToeMatchDO"]
    }
  ],
  "compatibility_flags": ["nodejs_compat"]
}
