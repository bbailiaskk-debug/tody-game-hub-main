{
  "name": "tody-game-hub",
  "compatibility_date": "2026-08-30",
  "main": ".output/server/index.mjs",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "854656836968-cvrr58sgldpa62sqicv8mn96jlamm7p7.apps.googleusercontent.com",
    "STRIPE_CURRENCY": "eur",
    "STRIPE_PRO_PAYMENT_LINK": "",
    "STRIPE_ENTERPRISE_PAYMENT_LINK": "",
    "STRIPE_PRO_PRICE_ID": "",
    "STRIPE_ENTERPRISE_PRICE_ID": "",
    "STRIPE_PRO_PRODUCT_ID": "prod_VKJJOcMwmT3JtF",
    "STRIPE_ENTERPRISE_PRODUCT_ID": "prod_VKJK0S8L5jBg3y"
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_USERS_KV",
      "id": "987d097bccb842538cf6af6ebafdbee5"
    },
    {
      "binding": "GEMINI_CACHE_KV",
      "id": "9c7d153cb68b46e1b07f0d9c61606999"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CHESS_GAME_DO",
        "class_name": "ChessMatchDO"
      },
      {
        "name": "TTT_GAME_DO",
        "class_name": "TicTacToeMatchDO"
      },
      {
        "name": "AIR_HOCKEY_DO",
        "class_name": "AirHockeyDO"
      },
      {
        "name": "MESSAGES_DO",
        "class_name": "MessagesDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChessMatchDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TicTacToeMatchDO"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AirHockeyDO"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["MessagesDO"]
    }
  ],
  "compatibility_flags": ["nodejs_compat"]
}
