# Copy to .env and fill in. VITE_* values are inlined into the client bundle at
# build time, so rebuild (`npm run build`) after changing them.

# Required for the "Login with Google" button. Google Cloud console -> APIs &
# Services -> Credentials -> OAuth 2.0 Client ID (Web application).
# Authorized redirect URI must be <origin>/login, e.g. http://localhost:8080/login
VITE_GOOGLE_CLIENT_ID=

# Server-side half of the same credential. In production it comes from
# `wrangler secret put GOOGLE_CLIENT_SECRET` / wrangler.json vars.
GOOGLE_CLIENT_SECRET=

# Sticker search in the chat. Public key, ships in the browser — giphy.com ->
# developers -> API keys. Empty means the picker shows a setup hint.
VITE_GIPHY_API_KEY=

# TURN for voice/video calls. Optional: STUN alone works on most networks.
VITE_TURN_URL=
VITE_TURN_USER=
VITE_TURN_CRED=

# YouTube Data API v3, for the /youtube section (src/lib/youtube-functions.ts).
# Server-only — the key is read inside the worker, never in the browser bundle.
# Create one at console.cloud.google.com -> APIs & Services -> Credentials ->
# API key, with "YouTube Data API v3" enabled.
# In production set it as a Worker secret: `wrangler secret put YOUTUBE_API_KEY`.
# Never commit the key itself.
YOUTUBE_API_KEY=

# The channel the /youtube section reads. Optional; defaults to the channel
# already linked in the site menu.
YOUTUBE_CHANNEL_ID=
